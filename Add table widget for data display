import tkinter as tk
from tkinter import ttk

root = tk.Tk()
root.title("Анализ данных - Лабораторная работа №3")
root.geometry("900x600")

label = tk.Label(root, text="Загрузите файл с данными", font=("Arial", 14))
label.pack(pady=20)

# Таблица для отображения данных
table = ttk.Treeview(root, columns=("Год", "Мужчины", "Женщины"), show="headings")
table.heading("Год", text="Год")
table.heading("Мужчины", text="Зарплата мужчины (руб)")
table.heading("Женщины", text="Зарплата женщины (руб)")
table.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

root.mainloop()
